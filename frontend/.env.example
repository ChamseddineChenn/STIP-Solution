# ===========================================
# STIP Solutions Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# API URL - Backend server URL
# LOCAL DEVELOPMENT: http://localhost:5000/api
# TESTING (via server IP - wait for DNS): http://YOUR_SERVER_IP:5000/api
# PRODUCTION: https://stip.ca/api
VITE_API_URL=http://localhost:5000/api

# Site URL (for meta tags, sharing, etc.)
# LOCAL DEVELOPMENT: http://localhost:5173
# TESTING (via server IP): http://YOUR_SERVER_IP
# PRODUCTION: https://stip.ca
VITE_SITE_URL=http://localhost:5173

# Environment
VITE_ENV=development

# Notes:
# - For testing via server IP before DNS propagates, update both URLs above to use YOUR_SERVER_IP
# - For production, use the domain name (https://stip.ca)
# - The frontend is served by Nginx, API calls are proxied to the Node.js backend
