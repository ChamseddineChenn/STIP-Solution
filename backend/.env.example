# ===========================================
# STIP Solutions Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local development: mongodb://localhost:27017/stip-solutions
# For production: Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stip-solutions

# JWT Secrets (Generate strong random strings for production!)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Cookie Settings
COOKIE_DOMAIN=localhost
# For production: .yourdomain.com (note the leading dot for subdomains)

# Default Admin Credentials (Used for seeding - Change in production!)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=YourSecurePassword123!

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS - Allowed Origins (comma-separated for multiple domains)
# LOCAL DEVELOPMENT: http://localhost:5173,http://localhost:5174,http://localhost:3000
# TESTING (via server IP before DNS): http://YOUR_SERVER_IP,http://YOUR_SERVER_IP:5000
# PRODUCTION: https://stip.ca,https://www.stip.ca
# COMBINED (during transition): http://localhost:5173,http://localhost:5174,http://YOUR_SERVER_IP,http://YOUR_SERVER_IP:5000,https://stip.ca,https://www.stip.ca
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Note: Replace YOUR_SERVER_IP with your actual VPS IP address (e.g., 192.168.1.100)
