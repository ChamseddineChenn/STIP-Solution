# ===========================================
# STIP Solutions Admin Panel - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# API URL - Backend server URL
# Development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api or https://yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Site URL (for meta tags, etc.)
VITE_SITE_URL=http://localhost:5174

# Environment
VITE_ENV=development
